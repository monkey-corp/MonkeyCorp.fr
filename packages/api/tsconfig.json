{
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",

    "noEmit": true,
    "allowImportingTsExtensions": true,

    "preserveSymlinks": true,

    "target": "ES2022",
    "lib": ["ES2022"],

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "exclude": [
    "test/*"
  ]
}
